# Roblox Open Cloud API key used by the existing group checker.
ROBLOX_API_KEY=replace_with_your_open_cloud_key

# Optional: protect write/delete actions. Recommended on Railway.
ADMIN_TOKEN=replace_with_a_long_random_secret

# Membership-age rules.
STANDARD_PAYOUT_WAIT_DAYS=14
VERIFIED_GROUP_PAYOUT_WAIT_DAYS=3

# Railway supplies PORT automatically.
PORT=3000

# Optional. On Railway with a mounted volume, point this into the volume.
# Example: DATA_FILE=/data/tracker.json
DATA_FILE=./data/tracker.json
